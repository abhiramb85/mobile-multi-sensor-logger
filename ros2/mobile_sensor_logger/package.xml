<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_sensor_logger</name>
  <version>0.1.0</version>
  <description>
    ROS 2 publisher nodes wrapping the mobile multi-sensor logger's existing
    camera / GPS / IMU drivers. Publishes NavSatFix, Imu, CompressedImage and
    CameraInfo for live use and `ros2 bag record`. The CSV acquisition pipeline
    remains ROS-free; these nodes are an additional live frontend.
  </description>
  <maintainer email="rakshithadevaraja28@gmail.com">Abhiram B</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
